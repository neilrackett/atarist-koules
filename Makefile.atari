# Atari ST cross build.
#
#   STCMD_NO_TTY=1 stcmd make -f Makefile.atari
#
# stcmd mounts the current directory as /tmp inside the toolkit
# container and runs there, so everything the build touches has to
# live inside this repository. STDL does: lib/stdl is a submodule,
# and libstdl.a is built from it automatically when it is missing.
#
#   git clone --recurse-submodules <url>     # fresh clone
#   git submodule update --init              # existing clone
#
#   KOULES.TOS   the game
#   KOULSFP4.TOS the game with float physics on a memory-mapped
#                68881/68882 (SFP-004 / Mega STE + GAL) via
#                atarist-sfp004; soft float without the FPU
#   KOULES.ST    a 720K floppy image of both, ready for Hatari or a
#                real drive; the game is AUTO\KOULES.PRG, so it
#                starts on power-up
#
# The on-target benchmarks are not part of the default build; "make
# -f Makefile.atari bench" (or make atari TARGET=bench) builds them:
#
#   BENCHX.TOS   16.16 fixed point simulation
#   BENCHF.TOS   upstream float simulation, for comparison
#   PHASEX.TOS   per-phase timing, fixed point (PHASE30: n=30)
#   PHASEF.TOS   per-phase timing, float
#   PHASESFP.TOS per-phase timing, float with sqrt on the SFP-004
#                (run it on the real FPU; Hatari has no CIR)

CC       = m68k-atari-mint-gcc
STRIP    = m68k-atari-mint-strip
NM       = m68k-atari-mint-nm
# tools/mkfloppy.py needs nothing but a stock interpreter, which is
# what the toolkit container has - no mtools in there.
PYTHON  ?= python3

# The submodule wins when it is present; a sibling checkout is the
# fallback, so the library and the game can still be worked on
# together. Override with STDL=<path>.
STDL    ?= $(firstword $(wildcard lib/stdl) ../atarist-stdl)
STDL_LIB = $(STDL)/libstdl.a

# Same arrangement for the SFP-004 FPU library: the submodule wins,
# a sibling checkout is the fallback.  Override with SFP004=<path>.
# Only KOULSFP4.TOS needs it; when neither is present that target
# just drops out of "all".
SFP004  ?= $(firstword $(wildcard lib/sfp004) ../atarist-sfp004)
SFP004_LIB = $(SFP004)/libsfp004.a

# Cloning without --recurse-submodules leaves lib/stdl an empty
# directory; say so rather than failing on a missing STDL.h.
ifeq ($(wildcard $(STDL)/include),)
ifeq ($(filter clean floatcheck,$(MAKECMDGOALS)),)
$(error STDL not found in $(STDL) - run: git submodule update --init)
endif
endif

# -m68000 is the correctness floor: a plain ST, no 020+ instructions.
CFLAGS   = -O2 -m68000 -fomit-frame-pointer -std=gnu99 -Wall -Wextra \
           -Wno-unused-parameter -I. -Isim
# Hatari GEMDOS-mounts the program's directory as a hard disk, and
# the default stack is too small for that path.
LDFLAGS  = -Wl,--traditional-format,--stack=32768

GAMEFLAGS = -O2 -m68000 -fomit-frame-pointer -std=gnu99 -Wall -Wextra \
            -Wno-unused-parameter -I. -Istdl -I$(STDL)/include \
            -DNODIRECT -DSTDLSUPPORT -DSOUND
GAMELIBS  = $(STDL_LIB)
# extra defines for the diagnostic build, e.g. DBGFLAGS='-DMAXACTIVE=16'
DBGFLAGS ?=

DIST     = dist
SIMSRC   = sim/bench.c sim/scenario.c krand.c
FIXSRC   = physics.c fixed.c sintab.c
GAMESRC  = koules.c menu.c gameplan.c framebuffer.c cmap.c rcfiles.c \
           krand.c $(FIXSRC) \
           stdl/init.c stdl/draw.c stdl/input.c stdl/intro.c \
           stdl/crawl.c stdl/sound.c
# the SFP-004 build swaps the fixed point physics for upstream's
# float physics with sqrt dispatched to the coprocessor
SFPSRC   = $(subst $(FIXSRC),physics_sfp.c,$(GAMESRC))
SFPFLAGS = $(GAMEFLAGS) -DKOULES_FLOAT -DKOULES_SFP004 -I$(SFP004)

# the SFP-004 targets only when the library is checked out somewhere
ifneq ($(wildcard $(SFP004)),)
SFPTARGET = $(DIST)/KOULSFP4.TOS
SFPBENCH  = $(DIST)/PHASESFP.TOS
endif

all: $(DIST)/KOULES.TOS $(SFPTARGET) assets $(DIST)/KOULES.ST

bench: $(DIST)/BENCHX.TOS $(DIST)/BENCHF.TOS \
       $(DIST)/PHASEX.TOS $(DIST)/PHASEF.TOS $(DIST)/PHASE30.TOS \
       $(SFPBENCH)

# The sample set the DMA backend loads at start-up: tracked in
# assets/, rebuilt from upstream's sounds/*.raw by tools/mksounds.sh.
WAVS     = $(patsubst assets/%,$(DIST)/%,$(wildcard assets/*.WAV))

assets: $(WAVS)

$(DIST)/%.WAV: assets/%.WAV | $(DIST)
	cp -f $< $@

# The floppy image.  The game lives in AUTO so that inserting the
# disk and switching the machine on is the whole of the user
# interface; the samples sit in the root, which is where an
# AUTO-folder program's current directory points, and where the game
# also writes KOULES.CFG and KOULES.LEV back.  KOULSFP4.TOS rides
# along at the root for the machines that have a coprocessor - run
# it from the desktop after quitting.
$(DIST)/KOULES.ST: $(DIST)/KOULES.TOS $(SFPTARGET) $(WAVS) \
                   tools/mkfloppy.py | $(DIST)
	$(PYTHON) tools/mkfloppy.py -o $@ -l KOULES \
	  $(DIST)/KOULES.TOS=AUTO/KOULES.PRG $(SFPTARGET) $(WAVS)

$(DIST):
	mkdir -p $(DIST)

# Build the library from the submodule when its archive is missing,
# so a fresh clone needs one command. An existing archive is left
# alone - rebuild it deliberately with make -C $(STDL).
$(STDL_LIB):
	$(MAKE) -C $(STDL) libstdl.a

$(SFP004_LIB):
	$(MAKE) -C $(SFP004) lib

$(DIST)/KOULES.TOS: $(GAMESRC) koules.h sound.h physics.h fixed.h gamedim.h \
                    stdl/interface.h stdl/font8x8.h text.h $(GAMELIBS) \
                    | $(DIST)
	$(CC) $(GAMEFLAGS) $(LDFLAGS) -o $@ $(GAMESRC) $(GAMELIBS)
	$(STRIP) $@

# -lm: ksqrt's fallback and the rest of the float physics soft-float
# through libm on machines without the coprocessor.
$(DIST)/KOULSFP4.TOS: $(SFPSRC) sim/physics_float.c koules.h sound.h \
                    physics.h gamedim.h \
                    stdl/interface.h stdl/font8x8.h text.h $(GAMELIBS) \
                    $(SFP004_LIB) | $(DIST)
	$(CC) $(SFPFLAGS) $(LDFLAGS) -o $@ $(SFPSRC) $(GAMELIBS) $(SFP004_LIB) -lm
	$(STRIP) $@

# Plays the seven effects in id order with console markers and
# exits, so a Hatari sound capture can be checked effect by effect.
$(DIST)/SFXTEST.TOS: $(GAMESRC) koules.h sound.h $(GAMELIBS) | $(DIST)
	$(CC) $(GAMEFLAGS) -DKOULES_SOUNDTEST $(LDFLAGS) -o $@ $(GAMESRC) $(GAMELIBS)
	$(STRIP) $@

# Same binary with a once-a-second frame report on the console: the
# ST prints onto the playfield, so this is a diagnostic build rather
# than a switch in the shipped one.
$(DIST)/KDEBUG.TOS: $(GAMESRC) koules.h $(GAMELIBS) | $(DIST)
	$(CC) $(GAMEFLAGS) -DKOULES_DEBUG $(DBGFLAGS) $(LDFLAGS) -o $@ $(GAMESRC) $(GAMELIBS)
	$(STRIP) $@

$(DIST)/BENCHX.TOS: $(SIMSRC) $(FIXSRC) koules.h physics.h fixed.h gamedim.h | $(DIST)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ $(SIMSRC) $(FIXSRC)

$(DIST)/BENCHF.TOS: $(SIMSRC) sim/physics_float.c koules.h physics.h gamedim.h | $(DIST)
	$(CC) $(CFLAGS) $(LDFLAGS) -DKOULES_FLOAT -o $@ $(SIMSRC) sim/physics_float.c -lm

$(DIST)/PHASEX.TOS: sim/phases.c sim/scenario.c krand.c $(FIXSRC) koules.h physics.h fixed.h gamedim.h | $(DIST)
	$(CC) $(CFLAGS) $(LDFLAGS) -o $@ sim/phases.c sim/scenario.c krand.c $(FIXSRC)

$(DIST)/PHASE30.TOS: sim/phases.c sim/scenario.c krand.c $(FIXSRC) koules.h physics.h fixed.h gamedim.h | $(DIST)
	$(CC) $(CFLAGS) $(LDFLAGS) -DN=30 -o $@ sim/phases.c sim/scenario.c krand.c $(FIXSRC)

$(DIST)/PHASEF.TOS: sim/phases.c sim/scenario.c krand.c sim/physics_float.c koules.h physics.h gamedim.h | $(DIST)
	$(CC) $(CFLAGS) $(LDFLAGS) -DKOULES_FLOAT -o $@ sim/phases.c sim/scenario.c krand.c sim/physics_float.c -lm

# PHASEF with the KOULSFP4 physics: sqrt dispatched to the 68882.
# The interesting run is on the real coprocessor - without it the
# fallback makes this PHASEF plus a cookie check per sqrt.
$(DIST)/PHASESFP.TOS: sim/phases.c sim/scenario.c krand.c physics_sfp.c \
                    sim/physics_float.c koules.h physics.h gamedim.h \
                    $(SFP004_LIB) | $(DIST)
	$(CC) $(CFLAGS) -DKOULES_FLOAT -DKOULES_SFP004 -I$(SFP004) $(LDFLAGS) -o $@ sim/phases.c sim/scenario.c krand.c physics_sfp.c $(SFP004_LIB) -lm

# Proof that no floating point survives in the fixed build: gcc
# emits calls to these libgcc soft-float helpers for every float
# or double operation, so their absence from the symbol table is a
# hard check, not an eyeball one.
# --traditional-format drops the symbol table, so the check runs
# against the objects, where every soft-float helper the compiler
# needs still shows up as an undefined symbol.
FLOATSYMS = '__(add|sub|mul|div|neg|cmp|eq|ne|lt|le|gt|ge)[sd]f|__float|__fix[usm]|__extend[sd]f|__trunc[sd]f|__[a-z]*sf3|__[a-z]*df3'

floatcheck:
	@rm -rf $(DIST)/objcheck && mkdir -p $(DIST)/objcheck
	@for f in $(SIMSRC) $(FIXSRC); do \
	   o=$(DIST)/objcheck/`basename $$f .c`.o; \
	   $(CC) $(CFLAGS) -c -o $$o $$f; \
	 done
	@echo "--- soft float / libm references in the FIXED build (expect none) ---"
	@$(NM) -u $(DIST)/objcheck/*.o | sort -u | \
	   grep -E $(FLOATSYMS)'|^ *U (sqrt|sin|cos|atan|hypot|pow|fabs)$$' \
	   && (echo "FAIL: floating point survives"; exit 1) \
	   || echo "  none - clean"
	@rm -rf $(DIST)/objcheckf && mkdir -p $(DIST)/objcheckf
	@for f in $(SIMSRC) sim/physics_float.c; do \
	   o=$(DIST)/objcheckf/`basename $$f .c`.o; \
	   $(CC) $(CFLAGS) -DKOULES_FLOAT -c -o $$o $$f; \
	 done
	@echo "--- same for the FLOAT reference build (expect many) ---"
	@$(NM) -u $(DIST)/objcheckf/*.o | sort -u | \
	   grep -E $(FLOATSYMS)'|^ *U (sqrt|sin|cos|atan|hypot|pow|fabs)$$' | sed 's/^/  /'
	@rm -rf $(DIST)/objcheck $(DIST)/objcheckf

clean:
	rm -f $(DIST)/KOULES.TOS $(DIST)/KOULSFP4.TOS $(DIST)/KDEBUG.TOS $(DIST)/SFXTEST.TOS $(DIST)/BENCHX.TOS $(DIST)/BENCHF.TOS $(DIST)/PHASEX.TOS $(DIST)/PHASEF.TOS $(DIST)/PHASE30.TOS $(DIST)/PHASESFP.TOS
	rm -f $(DIST)/*.WAV $(DIST)/KOULES.ST

.PHONY: all assets bench clean floatcheck
