# Host build of the deterministic simulation harness.
#   make -f Makefile.sim check   -- float vs 16.16 divergence report
#
# Two separate binaries rather than one: each links its own copy
# of the physics and its own globals, so there is no chance of the
# reference build being contaminated by the converted one.

CC      ?= cc
CFLAGS  ?= -O2 -g -Wall -Wextra -Wno-unused-parameter -std=gnu99
INC      = -Isrc -Isrc/sim

DIST     = dist
COMMON   = src/sim/dump.c src/sim/scenario.c src/krand.c
FIXED    = src/physics.c src/fixed.c src/sintab.c

all: $(DIST)/dumpf $(DIST)/dumpx

$(DIST):
	mkdir -p $(DIST)

$(DIST)/dumpf: $(COMMON) src/sim/physics_float.c src/koules.h src/physics.h | $(DIST)
	$(CC) $(CFLAGS) $(INC) -DKOULES_FLOAT -o $@ $(COMMON) src/sim/physics_float.c -lm

$(DIST)/dumpx: $(COMMON) $(FIXED) src/koules.h src/physics.h src/fixed.h | $(DIST)
	$(CC) $(CFLAGS) $(INC) -o $@ $(COMMON) $(FIXED)

check: $(DIST)/dumpf $(DIST)/dumpx
	@for n in 5 10 20 30; do \
	  ./$(DIST)/dumpf $$n 300 12345 > /tmp/koules_f_$$n.csv; \
	  ./$(DIST)/dumpx $$n 300 12345 > /tmp/koules_x_$$n.csv; \
	  python3 src/sim/compare.py /tmp/koules_f_$$n.csv /tmp/koules_x_$$n.csv $$n; \
	done

clean:
	rm -f $(DIST)/dumpf $(DIST)/dumpx
