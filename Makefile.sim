# Host build of the deterministic simulation harness.
#   make -f Makefile.sim check   -- float vs 16.16 divergence report
#
# Two separate binaries rather than one: each links its own copy
# of the physics and its own globals, so there is no chance of the
# reference build being contaminated by the converted one.

CC      ?= cc
CFLAGS  ?= -O2 -g -Wall -Wextra -Wno-unused-parameter -std=gnu99
INC      = -I. -Isim

COMMON   = sim/dump.c sim/scenario.c krand.c
FIXED    = physics.c fixed.c sintab.c

all: sim/dumpf sim/dumpx

sim/dumpf: $(COMMON) sim/physics_float.c koules.h physics.h
	$(CC) $(CFLAGS) $(INC) -DKOULES_FLOAT -o $@ $(COMMON) sim/physics_float.c -lm

sim/dumpx: $(COMMON) $(FIXED) koules.h physics.h fixed.h
	$(CC) $(CFLAGS) $(INC) -o $@ $(COMMON) $(FIXED)

check: sim/dumpf sim/dumpx
	@for n in 5 10 20 30; do \
	  ./sim/dumpf $$n 300 12345 > /tmp/koules_f_$$n.csv; \
	  ./sim/dumpx $$n 300 12345 > /tmp/koules_x_$$n.csv; \
	  python3 sim/compare.py /tmp/koules_f_$$n.csv /tmp/koules_x_$$n.csv $$n; \
	done

clean:
	rm -f sim/dumpf sim/dumpx
